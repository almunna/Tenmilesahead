rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isIsoDate(s) {
      return s is string && s.size() == 10 && s.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    /* -------- users -------- */
    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.username is string;
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    /* -------- trips -------- */
    match /trips/{tripId} {
      function validTripCreate() {
        return request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && isIsoDate(request.resource.data.startDate)
          && isIsoDate(request.resource.data.endDate)
          && request.resource.data.startDate <= request.resource.data.endDate
          && request.resource.data.country is string && request.resource.data.country.size() > 0
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      function validTripUpdate() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is number
          && request.resource.data.updatedAt > resource.data.updatedAt
          && request.resource.data.name is string
          && isIsoDate(request.resource.data.startDate)
          && isIsoDate(request.resource.data.endDate)
          && request.resource.data.startDate <= request.resource.data.endDate
          && request.resource.data.country is string;
      }

      allow create: if signedIn() && validTripCreate();
      // Public read for share links
      allow read:   if true;
      allow update: if isOwner(resource.data.ownerId) && validTripUpdate();
      allow delete: if isOwner(resource.data.ownerId);

      /* ---- media subcollection ---- */
      match /media/{mediaId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validMediaCreate() {
          return (request.resource.data.type == "image" || request.resource.data.type == "video" || request.resource.data.type == "document")
            && request.resource.data.downloadURL is string
            && request.resource.data.createdAt is number
            && (!('caption' in request.resource.data) || request.resource.data.caption is string)
            && (!('fileName' in request.resource.data) || request.resource.data.fileName is string)
            && (!('size' in request.resource.data) || request.resource.data.size is number)
            && (!('fileSize' in request.resource.data) || request.resource.data.fileSize is number)
            && (!('mimeType' in request.resource.data) || request.resource.data.mimeType is string)
            && (!('contentType' in request.resource.data) || request.resource.data.contentType is string)
            && (!('linkedSubcollection' in request.resource.data) || request.resource.data.linkedSubcollection is string)
            && (!('linkedId' in request.resource.data) || request.resource.data.linkedId is string);
        }

        function validMediaUpdate() {
          return request.resource.data.type == resource.data.type
            && request.resource.data.downloadURL == resource.data.downloadURL
            && request.resource.data.createdAt == resource.data.createdAt
            && (!('caption' in request.resource.data) || request.resource.data.caption is string);
        }

        allow create: if isOwner(parentOwner()) && validMediaCreate();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validMediaUpdate();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- destinations subcollection ---- */
      match /destinations/{destId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validSubitemData() {
          return request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.city is string
            && request.resource.data.country is string && request.resource.data.country.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number;
        }

        allow create: if isOwner(parentOwner()) && validSubitemData();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validSubitemData();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- activities subcollection ---- */
      match /activities/{actId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validSubitemData() {
          let isOnShip = 'onShip' in request.resource.data && request.resource.data.onShip == true;
          return request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number
            && (isOnShip || (request.resource.data.city is string && request.resource.data.country is string && request.resource.data.country.size() > 0));
        }

        allow create: if isOwner(parentOwner()) && validSubitemData();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validSubitemData();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- accommodations subcollection ---- */
      match /accommodations/{accId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validSubitemData() {
          let isOnShip = 'onShip' in request.resource.data && request.resource.data.onShip == true;
          return request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number
            && (isOnShip || (request.resource.data.city is string && request.resource.data.country is string && request.resource.data.country.size() > 0));
        }

        allow create: if isOwner(parentOwner()) && validSubitemData();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validSubitemData();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- restaurants subcollection ---- */
      match /restaurants/{restId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validSubitemData() {
          let isOnShip = 'onShip' in request.resource.data && request.resource.data.onShip == true;
          return request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number
            && (isOnShip || (request.resource.data.city is string && request.resource.data.country is string && request.resource.data.country.size() > 0));
        }

        allow create: if isOwner(parentOwner()) && validSubitemData();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validSubitemData();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- cruises subcollection ---- */
      match /cruises/{cruiseId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validSubitemData() {
          return request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.city is string
            && request.resource.data.country is string && request.resource.data.country.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number;
        }

        allow create: if isOwner(parentOwner()) && validSubitemData();
        // Public read for share links
        allow read:   if true;
        allow update: if isOwner(parentOwner()) && validSubitemData();
        allow delete: if isOwner(parentOwner());
      }

      /* ---- photobooks subcollection ---- */
      match /photobooks/{photobookId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
        }

        function validPhotobookCreate() {
          return request.resource.data.tripId == tripId
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.title is string
            && request.resource.data.pageSize is string
            && request.resource.data.binding is string
            && request.resource.data.pages is list
            && request.resource.data.createdAt is number
            && request.resource.data.updatedAt is number;
        }

        function validPhotobookUpdate() {
          return request.resource.data.tripId == resource.data.tripId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt is number
            && request.resource.data.updatedAt >= resource.data.updatedAt;
        }

        allow create: if isOwner(parentOwner()) && validPhotobookCreate();
        allow read:   if isOwner(parentOwner());
        allow update: if isOwner(parentOwner()) && validPhotobookUpdate();
        allow delete: if isOwner(parentOwner());
      }
    }

    /* -------- tutorials -------- */
    match /tutorials/{tutorialId} {
      allow read: if true; // Public read for all users
      allow create, update, delete: if isAdmin();
    }
  }
}
